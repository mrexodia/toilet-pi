{
  "name": "toilet-pi",
  "version": "2.0.0",
  "description": "Remote control pi sessions from a central web UI",
  "author": "mrexodia",
  "license": "MPL-2.0",
  "homepage": "https://github.com/mrexodia/toilet-pi#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrexodia/toilet-pi.git"
  },
  "bugs": {
    "url": "https://github.com/mrexodia/toilet-pi/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "toilet-pi": "./cli/toilet-pi.js"
  },
  "omp": {
    "extensions": [
      "./toilet-pi.ts"
    ]
  },
  "pi": {
    "extensions": [
      "./toilet-pi.ts"
    ]
  },
  "scripts": {
    "start": "npm start --prefix server",
    "dev": "npm run dev --prefix server",
    "dev:cf": "npm run dev:cf --prefix server",
    "deploy": "npm run deploy --prefix server",
    "server": "npm start --prefix server",
    "supervisor": "node supervisor.js",
    "client": "node cli/toilet-pi.js",
    "test": "node --test test/*.test.js",
    "setup": "npm install && npm install --prefix server && npm run build:client --prefix server"
  },
  "dependencies": {
    "ws": "^8.21.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "keywords": [
    "pi",
    "pi-package",
    "omp-extension",
    "websocket",
    "remote-control",
    "daemon"
  ]
}
