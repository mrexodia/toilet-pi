{
  "name": "toilet-pi-server",
  "private": true,
  "type": "module",
  "scripts": {
    "prestart": "npm run build:client",
    "start": "tsx src/node/entry.ts",
    "predev": "npm run build:client",
    "dev": "tsx --watch src/node/entry.ts",
    "build": "tsc && npm run build:client",
    "build:client": "node scripts/build-client.js",
    "check": "tsc --noEmit",
    "dev:cf": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "dompurify": "^3.4.15",
    "marked": "^18.0.11",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "0.27.7",
    "jsdom": "^30.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2",
    "wrangler": "^4.81.1"
  }
}
